# Browser URL and server bind address (one port for UI and API).
SERVER_URL=http://127.0.0.1:8000

# Local AI diagnosis service.
OLLAMA_BASE=http://127.0.0.1:11434
OLLAMA_MODEL=exaone3.5:7.8b
OLLAMA_AUTO_START=true

# A single FIFO worker prevents GPU and chart collisions; clients poll their own jobs.
JOB_QUEUE_CAPACITY=32
MAX_PENDING_PER_SESSION=4
SESSION_TTL_SECONDS=86400
MAX_SESSIONS=256
MAX_JOBS_PER_SESSION=128
MAX_UPLOADS_PER_SESSION=64
MAX_UPLOAD_MB=32

# Generate a unique value: python -c "import secrets; print(secrets.token_hex(32))"
FLET_SECRET_KEY=replace-with-a-random-secret
